# ── Server Configuration ───────────────────────────────────────────────────────
PORT=5174
WEB_URL=http://localhost:5174

# ── Supabase Configuration ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ── Auth Redirect URLs ────────────────────────────────────────────────────────
PASSWORD_RESET_REDIRECT_URL=http://localhost:5174/forgot-password
EMAIL_REDIRECT_URL=http://localhost:5174/verify-email

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ally-jis-media
R2_PUBLIC_DOMAIN=https://media.ally-jis.xyz

# ── Resend Email Service (OTP) ────────────────────────────────────────────────
# Get API key from https://resend.com/api-keys
# Leave RESEND_API_KEY blank to log OTP codes to the terminal console during dev
RESEND_API_KEY=re_123456789_your_api_key_here
RESEND_FROM="Ally-jis" <no-reply@ally-jis.xyz>

# ── OTP Security Rules ────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_RESENDS=3
