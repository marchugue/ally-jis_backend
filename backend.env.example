# Server
PORT=3001
WEB_URL=*

# Supabase (Project Settings → API)
SUPABASE_URL=https://bbktizewwzdgohkvvzxs.supabase.co
SUPABASE_ANON_KEY=sb_publishable_9FF5V9zxRLCbQbbOzzf9Lw_-yxbjKEi
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Password reset — must exactly match a URL in Supabase's
# Authentication → URL Configuration → Redirect URLs allowlist
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/forgot-password

# Optional: direct Postgres (Project Settings → Database → Connection string → URI)
# Use "Session pooler" or "Transaction pooler" for server apps
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── Cloudflare R2 Media Storage ─────────────────────────────────────────────
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Leave ALL four blank to fall back to Supabase Storage during local development.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ally-jis-media
# Public domain for your R2 bucket (Enable "Public access" in the R2 bucket settings)
# e.g. https://pub-xxxxxxxxxxxxxxxx.r2.dev  OR  https://media.yourdomain.com
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev
