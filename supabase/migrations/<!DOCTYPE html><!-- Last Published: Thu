    <script>
        (function () {
            const PREV_TABINDEX = 'data-a11y-prev-tabindex';
            const STYLE_ID = 'a11y-patch-extra';

            const focusableSelector = ['a[href]', 'area[href]', 'button:not([disabled])', 'input:not([disabled]):not([type="hidden"])', 'select:not([disabled])', 'textarea:not([disabled])', 'iframe', 'object', 'embed', '[contenteditable="true"]', '[tabindex]'].join(',');

            const q = (selector, root = document) => Array.from(root.querySelectorAll(selector));

            const cleanText = (value) =>
                String(value || '')
                    .replace(/\s+/g, ' ')
                    .trim();

            const hasAttr = (el, attr) => el && el.hasAttribute(attr);

            const getLabelledByText = (el) => {
                const ids = cleanText(el.getAttribute('aria-labelledby'));
                if (!ids) return '';

                return cleanText(
                    ids
                        .split(/\s+/)
                        .map((id) => document.getElementById(id))
                        .filter(Boolean)
                        .map((node) => node.textContent)
                        .join(' '),
                );
            };

            const hasAriaName = (el) => {
                return !!cleanText(el.getAttribute('aria-label')) || !!getLabelledByText(el);
            };

            const titleCase = (value) => {
                const text = cleanText(value);
                if (!text) return '';
                if (text !== text.toUpperCase()) return text;

                return text.toLowerCase().replace(/\b\w/g, (char) => char.toUpperCase());
            };

            const safeCssId = (id) => {
                if (window.CSS && typeof window.CSS.escape === 'function') return window.CSS.escape(id);
                return String(id).replace(/["\\#.;:[\](){}+>~*^$|=!,]/g, '\\$&');
            };

            function getControlName(control) {
                if (hasAriaName(control)) return 'ok';

                if (control.labels && control.labels.length) {
                    const labelText = cleanText(control.labels[0].textContent);
                    if (labelText) return labelText;
                }

                if (control.id) {
                    const label = document.querySelector('label[for="' + safeCssId(control.id) + '"]');
                    const labelText = cleanText(label && label.textContent);
                    if (labelText) return labelText;
                }

                return cleanText(control.getAttribute('placeholder')) || cleanText(control.getAttribute('data-name')) || cleanText(control.getAttribute('name')).replace(/[-_]+/g, ' ') || cleanText(control.id).replace(/[-_]+/g, ' ');
            }

            function patchForms() {
                const calculatorLabels = new Map([
                    ['cost-marketing', 'Cost of marketing (USD)'],
                    ['cost-sales', 'Cost of sales (USD)'],
                    ['new-customers', 'Number of new customers'],
                    ['arpu', 'Average revenue per user (ARPU)'],
                    ['churn', 'Churn (%)'],
                    ['gross-margin', 'Gross margin (%)'],
                    ['starting-customers', 'Starting customers'],
                    ['lost-customers', 'Lost customers'],
                ]);

                q('input, textarea, select').forEach((control) => {
                    const type = String(control.type || '').toLowerCase();
                    if (['hidden', 'submit', 'button', 'reset'].includes(type)) return;

                    const name = getControlName(control);
                    if (name && name !== 'ok' && !hasAriaName(control)) {
                        control.setAttribute('aria-label', name);
                    }
                });

                q('input[name="honeypot"], input.form-input-hnptcorrect').forEach((input) => {
                    input.setAttribute('tabindex', '-1');
                    input.setAttribute('autocomplete', 'off');
                    if (!hasAriaName(input)) input.setAttribute('aria-label', 'Leave this field empty');
                });

                calculatorLabels.forEach((label, id) => {
                    const el = document.getElementById(id);
                    if (el && !hasAriaName(el)) el.setAttribute('aria-label', label);
                });
            }

            function patchBlogCardLists() {
                q('.blog-card-list').forEach((list) => {
                    const tag = list.tagName.toLowerCase();

                    if (tag !== 'ul' && tag !== 'ol') {
                        list.setAttribute('role', 'group');
                    }

                    if (!hasAriaName(list)) {
                        list.setAttribute('aria-label', 'Related blog posts carousel');
                    }
                });

                q('.blog-card').forEach((card) => {
                    if (!card.matches('a, button, li') && !hasAttr(card, 'role')) {
                        card.setAttribute('role', 'group');
                    }
                });
            }

            function patchOrphanListItems() {
                const parents = new Set();

                q('li').forEach((li) => {
                    const parent = li.parentElement;
                    if (!parent) return;
                    if (/^(UL|OL|MENU)$/i.test(parent.tagName)) return;
                    parents.add(parent);
                });

                parents.forEach((parent) => {
                    let wrapper = null;

                    Array.from(parent.childNodes).forEach((node) => {
                        const isOrphanLi = node.nodeType === 1 && node.tagName === 'LI';

                        if (isOrphanLi) {
                            if (!wrapper) {
                                wrapper = document.createElement('ul');
                                wrapper.setAttribute('data-a11y-generated-list', 'true');
                                parent.insertBefore(wrapper, node);
                            }

                            wrapper.appendChild(node);
                            return;
                        }

                        if (node.nodeType === 3 && !cleanText(node.textContent)) return;

                        wrapper = null;
                    });
                });
            }

            function getLinkName(link) {
                if (hasAriaName(link)) return 'ok';

                const visibleText = cleanText(link.textContent);
                if (visibleText) return visibleText;

                const title = cleanText(link.getAttribute('title'));
                if (title) return title;

                const imageText = cleanText(
                    q('img', link)
                        .map((img) => img.getAttribute('alt') || img.getAttribute('title') || img.getAttribute('aria-label'))
                        .join(' '),
                );
                if (imageText) return imageText;

                const href = cleanText(link.getAttribute('href'));
                if (!href || href === '#') return '';

                if (href.startsWith('mailto:')) return 'Email ' + href.replace(/^mailto:/, '');
                if (href.startsWith('tel:')) return 'Call ' + href.replace(/^tel:/, '');

                try {
                    const url = new URL(href, window.location.href);
                    return 'Link to ' + cleanText(url.hostname + url.pathname).replace(/\/$/, '');
                } catch (_error) {
                    return 'Link to ' + href;
                }
            }

            function patchBannerBlocks() {
                const genericAlts = new Set(['', 'image', 'img', 'banner', 'book', 'ebook', 'cover', 'photo', 'picture']);

                q('.banner-wrap').forEach((banner) => {
                    const heading = titleCase(banner.querySelector('h3') && banner.querySelector('h3').textContent);

                    q('a.bann-btn', banner).forEach((link) => {
