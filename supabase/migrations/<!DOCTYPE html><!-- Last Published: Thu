            function onSmoothScroll(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const target = document.querySelector(targetId);

                if (!target) return;

                const lazyImages = target.querySelectorAll('img[loading="lazy"]');
                if (lazyImages.length) {
