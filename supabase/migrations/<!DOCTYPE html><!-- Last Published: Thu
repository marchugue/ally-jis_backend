    <script>
        (() => {
            'use strict';

            const COLUMN_START = 3;
            const SWIPE_MIN = 40;
            const SWIPE_SLOPE = 1.2;
            const DRAG_MIN = 8;
            const DRAG_RESIST = 0.3;

            const text = (el) => (el.textContent || '').replace(/\s+/g, ' ').trim();

            const readTable = (root) => {
                const source = root.querySelector('[data-bt-source]');
                if (!source) return null;

                const headRow = source.querySelector('thead tr');
                const bodyRows = source.querySelectorAll('tbody tr');
                if (!headRow || !bodyRows.length) return null;

                const columns = [];
                for (let i = 1; i < headRow.children.length; i++) {
                    columns.push(text(headRow.children[i]));
                }
                if (!columns.length) return null;

                const rows = [];
                for (let i = 0; i < bodyRows.length; i++) {
                    const cells = bodyRows[i].children;
                    const values = [];
                    for (let c = 1; c < cells.length; c++) values.push(text(cells[c]));
                    rows.push({ label: cells.length ? text(cells[0]) : '', values });
                }

                return { columns, rows };
            };

            const columnsPerPage = (root) => {
                const declared = parseInt(getComputedStyle(root).getPropertyValue('--bt-columns'), 10);

                return declared > 0 ? declared : 2;
            };

            const cell = (className, textClass, text, column, row) => {
                const el = document.createElement('div');
                el.className = className;
                if (column) el.style.gridColumn = String(column);
                if (row) el.style.gridRow = String(row);

                if (text) {
                    const span = document.createElement('span');
                    span.className = textClass;
                    span.textContent = text;
                    el.appendChild(span);
                }

                return el;
            };

            const divider = (className, row) => {
                const el = document.createElement('div');
                el.className = `bt-divider ${className}`;
                el.style.gridRow = String(row);
                return el;
            };

            const viewportWidth = (state) => {
                const vp = state.grid.querySelector('.bt-viewport');
                return vp ? vp.clientWidth : 0;
            };

            const baseShift = (state) => {
                const width = viewportWidth(state);
                if (!width) return 0;

                const trackWidth = (width * state.data.columns.length) / state.perPage;
                const furthest = Math.max(0, trackWidth - width);

                return -Math.min(state.page * width, furthest);
            };

            const applyShift = (state, drag, animate) => {
                if (animate) {
                    state.root.classList.add('bt-animating');
                } else {
                    state.root.classList.remove('bt-animating');
                }

                state.root.style.setProperty('--bt-shift', `${baseShift(state) + drag}px`);
            };

            const updateArrows = (state) => {
                const pages = state.pageCount();

                state.nav.hidden = pages < 2;
                state.prev.disabled = state.page === 0;
                state.next.disabled = state.page >= pages - 1;
            };

            const dividerPair = (frag, row) => {
                frag.appendChild(divider('bt-divider-label', row));
                frag.appendChild(divider('bt-divider-cols', row));
            };

            const bindSwipe = (state, surface, go) => {
                if (!surface) return;

                let startX = 0;
                let startY = 0;
                let tracking = false;
                let dragging = false;

                const resisted = (dx) => {
                    const blocked = dx > 0 ? state.page === 0 : state.page >= state.pageCount() - 1;

                    return blocked ? dx * DRAG_RESIST : dx;
                };

                surface.addEventListener('touchstart', (event) => {
                    tracking = event.touches.length === 1;
                    dragging = false;
                    if (!tracking) return;
                    startX = event.touches[0].clientX;
                    startY = event.touches[0].clientY;
                });

                surface.addEventListener('touchmove', (event) => {
                    if (!tracking) return;

                    const dx = event.touches[0].clientX - startX;
                    const dy = event.touches[0].clientY - startY;

                    if (!dragging) {
                        if (Math.abs(dx) < DRAG_MIN) return;
                        if (Math.abs(dx) < Math.abs(dy) * SWIPE_SLOPE) {
                            tracking = false;
                            return;
                        }
                        dragging = true;
                    }

                    applyShift(state, resisted(dx), false);
                });

                surface.addEventListener('touchend', (event) => {
                    if (!tracking) return;
                    tracking = false;

                    const touch = event.changedTouches[0];
                    const dx = touch.clientX - startX;
                    const dy = touch.clientY - startY;
                    const settled = dragging;
                    dragging = false;

                    if (Math.abs(dx) < SWIPE_MIN) {
                        if (settled) applyShift(state, 0, true);
                        return;
                    }

                    if (Math.abs(dx) < Math.abs(dy) * SWIPE_SLOPE) {
                        if (settled) applyShift(state, 0, true);
                        return;
                    }

                    go(dx < 0 ? 1 : -1);
                });

                surface.addEventListener('touchcancel', () => {
                    if (dragging) applyShift(state, 0, true);
                    tracking = false;
                    dragging = false;
                });
            };

            const render = (state) => {
                const data = state.data;
                const total = data.columns.length;
                const frag = document.createDocumentFragment();
                let row = 1;

                state.grid.style.gridTemplateColumns = 'var(--bt-label-col) var(--bt-spacer-col) 1fr';

                const track = (atRow) => {
                    const viewport = document.createElement('div');
                    viewport.className = 'bt-viewport';
                    viewport.style.gridColumn = `${COLUMN_START} / -1`;
                    viewport.style.gridRow = String(atRow);

                    const strip = document.createElement('div');
                    strip.className = 'bt-track';
                    strip.style.gridTemplateColumns = `repeat(${total}, 1fr)`;
                    strip.style.width = `${(100 * total) / state.perPage}%`;

                    viewport.appendChild(strip);
                    frag.appendChild(viewport);

                    return strip;
                };

                const colClass = (index) => `bt-cell-col${index % state.perPage === 0 ? ' bt-cell-col-first' : ''}`;

                frag.appendChild(cell('bt-cell bt-cell-head', '', '', 1, row));
                const head = track(row);
                data.columns.forEach((label, i) => {
                    head.appendChild(cell(`bt-cell bt-cell-head ${colClass(i)}`, 'bt-col-label', label));
                });
                row += 1;

                dividerPair(frag, row);
                row += 1;

                data.rows.forEach((item, index) => {
                    frag.appendChild(cell('bt-cell', 'bt-row-label', item.label, 1, row));
                    const strip = track(row);
                    for (let i = 0; i < total; i++) {
                        strip.appendChild(cell(`bt-cell ${colClass(i)}`, 'bt-text', item.values[i] || ''));
                    }
                    row += 1;

                    if (index < data.rows.length - 1) {
                        dividerPair(frag, row);
                        row += 1;
                    }
                });

                state.grid.innerHTML = '';
                state.grid.appendChild(frag);

                updateArrows(state);
                applyShift(state, 0, false);
            };

            const init = (root, data) => {
                const state = {
                    data,
                    root,
                    grid: root.querySelector('[data-bt-grid]'),
                    nav: root.querySelector('[data-bt-nav]'),
                    prev: root.querySelector('[data-bt-prev]'),
                    next: root.querySelector('[data-bt-next]'),
                    perPage: columnsPerPage(root),
                    page: 0,
                    pageCount() {
                        return Math.max(1, Math.ceil(data.columns.length / state.perPage));
                    },
                };

                const go = (delta) => {
                    const next = state.page + delta;
                    if (next >= 0 && next <= state.pageCount() - 1) {
                        state.page = next;
                        updateArrows(state);
                    }

                    applyShift(state, 0, true);
                };

                state.prev.addEventListener('click', () => {
                    go(-1);
                });
                state.next.addEventListener('click', () => {
                    go(1);
                });

                bindSwipe(state, root.querySelector('[data-bt-surface]'), go);

                const syncLayout = () => {
                    const perPage = columnsPerPage(root);

                    if (perPage !== state.perPage) {
                        const firstVisible = state.page * state.perPage;
                        state.perPage = perPage;
                        state.page = Math.min(Math.floor(firstVisible / perPage), state.pageCount() - 1);
                        render(state);
                        return;
                    }

                    applyShift(state, 0, false);
                };

                if (typeof ResizeObserver === 'function') {
                    new ResizeObserver(syncLayout).observe(root);
                }

                window.addEventListener('resize', syncLayout);

                render(state);
            };

            const roots = document.querySelectorAll('[data-bt-table]');
            for (const root of roots) {
                if (root.getAttribute('data-bt-ready') === 'true') continue;
                const data = readTable(root);
                if (!data) continue;
                root.setAttribute('data-bt-ready', 'true');
                init(root, data);
            }
        })();
    </script>
