                            } else {
                                img.addEventListener('load', resolve);
                                img.addEventListener('error', resolve);
                            }
                        });
                    });
                    Promise.all(waits).then(() => scrollToTarget(target, 3000));
                } else {
                    scrollToTarget(target, 3000);
                }
